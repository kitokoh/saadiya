    def start_installation(self):
        self.install_button.setEnabled(False)
        self.cancel_button.setEnabled(True)
        self.log_output.clear()
        
        options = {
            "create_venv": self.create_venv_check.isChecked(),
            "install_deps": self.install_deps_check.isChecked(),
            "create_data_dir": self.create_data_dir_check.isChecked(),
            "launch_after": self.launch_after_check.isChecked()
        }
        
        self.install_thread = InstallerThread(options)
        self.install_thread.progress_signal.connect(self.update_progress)
        self.install_thread.finished_signal.connect(self.installation_finished)
        self.install_thread.log_signal.connect(self.update_log)
        self.install_thread.start()
    
    def cancel_installation(self):
        if self.install_thread and self.install_thread.isRunning():
            reply = QMessageBox.question(
                self, "Confirmation",
                "Êtes-vous sûr de vouloir annuler l'installation?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                self.install_thread.stop()
                self.status_label.setText("Installation annulée")
                self.log_output.append(">>> Installation annulée par l'utilisateur")
                self.install_button.setEnabled(True)
                self.cancel_button.setEnabled(False)
    
    def update_progress(self, value, message):
        self.progress_bar.setValue(value)
        self.status_label.setText(message)
    
    def update_log(self, message):
        self.log_output.append(message)
        # Auto-scroll to bottom
        self.log_output.verticalScrollBar().setValue(self.log_output.verticalScrollBar().maximum())
    
    def installation_finished(self, success, message):
        self.install_button.setEnabled(True)
        self.cancel_button.setEnabled(False)
        
        if success:
            QMessageBox.information(
                self, "Installation réussie",
                f"""{message}
                
                Mayan EDMS a été installé avec succès!
                
                Pour démarrer Mayan EDMS, ouvrez un terminal et exécutez:
                ~/mayan-venv/bin/mayan-edms.py runserver
                
                Puis ouvrez http://localhost:8000 dans votre navigateur.
                """,
                QMessageBox.Ok
            )
            
            if self.launch_after_check.isChecked():
                self.launch_mayan()
        else:
            QMessageBox.critical(
                self, "Erreur d'installation",
                message,
                QMessageBox.Ok
            )
        
        self.progress_bar.setValue(0)
        self.status_label.setText("Prêt à installer")
    
    def launch_mayan(self):
        venv_dir = os.path.join(os.path.expanduser("~"), "mayan-venv")
        data_dir = os.path.join(os.path.expanduser("~"), "mayan-data")
        
        if platform.system() == "Windows":
            mayan_path = os.path.join(venv_dir, "Scripts", "mayan-edms.py")
            subprocess.Popen(["start", "cmd", "/k", mayan_path, "runserver"], shell=True, cwd=data_dir)
        else:
            mayan_path = os.path.join(venv_dir, "bin", "mayan-edms.py")
            subprocess.Popen(["x-terminal-emulator", "-e", mayan_path, "runserver"], cwd=data_dir)
        
        # Ouvrir le navigateur après un court délai
        QTimer.singleShot(3000, lambda: webbrowser.open("http://localhost:8000"))


