SetupIconFile=D:\nova360\lang\resources\icons\robot-icons-30504-Windows.ico

Compression=lzma
SolidCompression=yes
WizardStyle=modern
AppCopyright=Copyright © 2024 {#MyAppPublisher}. All rights reserved.
MinVersion=10.0.0
AlwaysShowDirOnReadyPage=yes
PrivilegesRequired=admin

OutputManifestFile=setup.log
UninstallDisplayIcon=D:\nova360\lang\resources\robot-icons-30504-Windows.ico
OutputDir=D:\Installations\Nova360

; Custom window images
