#define MyAppName "Remote AI"
#define MyAppVersion "1.9"
#define MyAppPublisher "Leopardo, Inc."
#define MyAppURL "https://www.leopardo.com/"
#define MyAppExeName "remote.exe"
#define MyAppDataDir "saadiya" 

#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
AppId={{6DE0F7C2-28A6-4695-941A-5D96CD9555CD}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName=MyApplication
ArchitecturesAllowed=x86 x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
LicenseFile=D:\nova360\lang\dist\licence.txt
InfoBeforeFile=D:\nova360\lang\dist\beforinstall.txt
InfoAfterFile=D:\nova360\lang\dist\afterinstall.txt
