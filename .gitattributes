*.psd filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.pkg filter=lfs diff=lfs merge=lfs -text
# Force Unix-style LF line endings
* text=auto eol=lf

# Optionnel : ignorer les binaires et .exe
*.exe binary
# Force LF
* text=auto eol=lf
# Garde CRLF sous Windows
* text=auto eol=crlf

