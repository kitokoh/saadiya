@echo off
setlocal enabledelayedexpansion

REM Définir le répertoire de base
set "base_dir=C:\wabon"

REM Parcourir les dossiers robot1, robot2, robot3, etc.
for /l %%i in (1,1,100) do (
    set "folder=%base_dir%\robot%%i"
    
    REM Vérifier si le dossier existe
    if exist "!folder!" (
        echo Suppression du dossier : 
        REM Supprimer le dossier et tous ses sous-dossiers, même s'ils sont cachés
        rd /s /q "!folder!"
    )
)

echo Tous les dossiers robot ont été supprimés.
pause